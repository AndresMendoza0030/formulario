{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "formulario",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "formulario-radiologia-db",
      "database_id": "37b252d1-efa9-4520-a198-4344a3dae05a"
    }
  ],
  "observability": {
    "enabled": true
  }
}
